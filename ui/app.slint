import { ScrollView, VerticalBox, HorizontalBox, Button, LineEdit, TextEdit, ComboBox, StandardTableView, Palette, DatePickerPopup } from "std-widgets.slint";

component DateField inherits HorizontalBox
{
    in-out property <string> value;

    pure function two-digits(number: int) -> string
    {
        return number < 10 ? "0" + number : "" + number;
    }

    Button
    {
        width: 110px;
        height: 24px;
        text: root.value == "" ? "Select date" : root.value;
        clicked => { picker.show(); }
    }
    Button
    {
        text: "×";
        height: 24px;
        enabled: root.value != "";
        clicked => { root.value = ""; }
    }
    picker := DatePickerPopup
    {
        accepted(date) =>
        {
            root.value = date.year + "-" + root.two-digits(date.month) + "-" + root.two-digits(date.day);
            picker.date = date;
        }
    }
}

component TradeContextItem inherits Rectangle
{
    in property <string> label;
    in property <color> hover-color;
    in property <color> foreground;
    callback activated();
    height: 32px;
    border-radius: 3px;
    background: hit-area.has-hover ? root.hover-color : #00000000;
    Text
    {
        x: 10px;
        width: parent.width - 20px;
        height: 100%;
        text: root.label;
        color: root.foreground;
        vertical-alignment: center;
    }
    hit-area := TouchArea
    {
        width: 100%;
        height: 100%;
        clicked => { root.activated(); }
    }
}

export struct TradeRow
{
    id: int,
    is-deleted: bool,
    review: string,
    premarket: string,
    is-closed: bool,
    product: string,
    currency: string,
    side: string,
    dates: string,
    date-buy: string,
    date-sell: string,
    shares-buy: string,
    shares-sell: string,
    edit-shares-buy: string,
    edit-shares-sell: string,
    price-buy: string,
    price-sell: string,
    exchange-rate-buy: string,
    exchange-rate-sell: string,
    commission-buy: string,
    tax-buy: string,
    commission-sell: string,
    tax-sell: string,
    cost-other: string,
    risk-percent-initial: string,
    risk-percent-actual: string,
    stoploss-initial: string,
    stoploss-actual: string,
    target-minimum: string,
    target-preferred: string,
    trade-pool: string,
    risk-initial: string,
    risk-actual: string,
    profit: string,
    profit-total: string,
    r: string,
}

export struct TradeCostRow
{
    id: int,
    product: string,
    date-buy: string,
    date-sell: string,
    commission-buy: string,
    tax-buy: string,
    commission-sell: string,
    tax-sell: string,
    other: string,
    total: string,
}

component FadedTradeRows inherits Rectangle
{
    in property <[TradeRow]> trades;
    in property <length> body-top;
    in property <length> body-height;
    in property <length> content-y;
    in property <length> content-height;
    y: root.body-top;
    width: 100%;
    height: root.body-height;
    clip: true;
    for trade[index] in root.trades: Rectangle
    {
        y: root.content-y + index * (root.trades.length > 0 ? root.content-height / root.trades.length : 0px);
        width: 100%;
        height: root.trades.length > 0 ? root.content-height / root.trades.length : 0px;
        background: trade.is-deleted ? #282828cc : #00000000;
    }
}

export component ImageViewer inherits Window
{
    title: root.image-title;
    min-width: 650px;
    min-height: 300px;
    preferred-width: 1000px;
    preferred-height: 700px;
    full-screen: true;
    background: #282828;
    default-font-size: 12px;

    in-out property <image> displayed-image;
    in-out property <string> image-title;
    in-out property <float> zoom: 1.0;
    callback dismiss();

    VerticalBox
    {
        padding: 8px;
        spacing: 8px;
        HorizontalBox
        {
            height: 32px;
            spacing: 8px;
            Text { text: root.image-title; color: #ebdbb2; vertical-alignment: center; horizontal-stretch: 1; }
            Button { text: "-"; enabled: root.zoom > 1.0; clicked => { root.zoom = max(1.0, root.zoom / 1.25); } }
            Text { text: round(root.zoom * 100) + "%"; color: #d5c4a1; vertical-alignment: center; }
            Button { text: "+"; enabled: root.zoom < 8.0; clicked => { root.zoom = min(8.0, root.zoom * 1.25); } }
            Button { text: "Fit"; clicked => { root.zoom = 1.0; } }
            Button { text: root.full-screen ? "Windowed" : "Full screen"; clicked => { root.full-screen = !root.full-screen; } }
            Button { text: "Close"; clicked => { root.dismiss(); } }
        }
        image-scroll := ScrollView
        {
            vertical-stretch: 1;
            content-width: image-scroll.visible-width * root.zoom;
            content-height: image-scroll.visible-height * root.zoom;
            Image
            {
                width: image-scroll.content-width;
                height: image-scroll.content-height;
                source: root.displayed-image;
                image-fit: contain;
            }
        }
    }
}

export struct ProductRow
{
    name: string,
    description: string,
    currency: string,
    market: string,
    tick: string,
    tick-value: string,
}

export struct MarketRow
{
    code: string,
    name: string,
    country: string,
}

export struct ParameterRow
{
    id: int,
    name: string,
    value: string,
    value-default: string,
    description: string,
    datatype: string,
}

export component AppWindow inherits Window
{

/*******************************************************************************
 * Settings
 *******************************************************************************/
    title: "CapitalCommander · Trade Journal";
    // Keep the native window constraints stable when conditional controls change.
    min-width: 1000px;
    min-height: 600px;
    preferred-width: 1120px;
    preferred-height: 760px;
    background: #282828;
    default-font-size: 12px;
    init => { Palette.color-scheme = ColorScheme.dark; }

    private property <color> primary: #ebdbb2;
    private property <color> secondary: #d5c4a1;
    private property <color> muted: #bdae93;
    private property <color> aqua: #8ec07c;
    private property <color> accent: #fabd2f;
    private property <color> surface: #3c3836;
    private property <color> divider: #665c54;
    private property <color> faded: #504945;
    private property <color> log: #83a598;
    in-out property <string> page: "Journal";
    in-out property <string> status: "Ready";
    private property <string> trade-warning: "Enter at least one trade date.";
    in-out property <string> source-label: "capitalcommander.sqlite3";
    in-out property <string> current-pool: "";
    in-out property <string> current-pool-exact: "";
    in-out property <string> base-currency: "";
    in-out property <string> journal-date-from: "";
    in-out property <string> journal-date-to: "";
    private property <string> journal-draft-from: "";
    private property <string> journal-draft-to: "";
    in-out property <[string]> products;
    in-out property <[ProductRow]> product-details;
    in-out property <[[StandardListViewItem]]> product-table-rows;
    in-out property <[string]> market-codes;
    in-out property <[MarketRow]> market-details;
    in-out property <[[StandardListViewItem]]> market-table-rows;
    in-out property <[ParameterRow]> parameters;
    in-out property <[[StandardListViewItem]]> parameter-table-rows;
    private property <int> editing-parameter-id: 0;
    private property <int> selected-parameter-row: -1;
    private property <string> parameter-name: "";
    private property <string> parameter-value: "";
    private property <string> parameter-default: "";
    private property <string> parameter-description: "";
    private property <string> parameter-datatype: "string";
    in-out property <[TradeRow]> trades;
    in-out property <[[StandardListViewItem]]> trade-table-rows;
    in-out property <[[StandardListViewItem]]> review-table-rows;
    in-out property <[[StandardListViewItem]]> premarket-table-rows;
    in-out property <int> editing-trade-id: 0;
    in-out property <int> selected-trade-row: -1;
    in-out property <int> selected-review-trade-id: 0;
    in-out property <int> selected-review-row: -1;
    in-out property <int> selected-premarket-trade-id: 0;
    in-out property <int> selected-premarket-row: -1;
    private property <int> context-trade-row: -1;
    private property <Point> context-menu-position;
    private property <int> journal-reset-token: 0;
    in-out property <string> review-text: "";
    in-out property <image> review-image;
    in-out property <bool> review-has-image: false;
    in-out property <string> premarket-text: "";
    in-out property <image> premarket-image;
    in-out property <bool> premarket-has-image: false;
    private property <string> trade-pool: root.current-pool-exact;
    private property <string> risk-entry-mode: "";
    in-out property <string> trade-count: "0";
    in-out property <string> win-rate: "—";
    in-out property <string> expectancy: "—";
    in-out property <string> total-pl: "—";
    in-out property <string> costs-date-from: "";
    in-out property <string> costs-date-to: "";
    private property <string> costs-draft-from: "";
    private property <string> costs-draft-to: "";
    in-out property <[TradeCostRow]> trade-costs;
    in-out property <[[StandardListViewItem]]> trade-cost-table-rows;
    in-out property <string> costs-count: "0";
    in-out property <string> costs-commission-buy: "0.00";
    in-out property <string> costs-tax-buy: "0.00";
    in-out property <string> costs-commission-sell: "0.00";
    in-out property <string> costs-tax-sell: "0.00";
    in-out property <string> costs-other: "0.00";
    in-out property <string> costs-total: "0.00";

    callback filter-journal(string, string) -> bool;
    callback save-trade-review(int, string) -> bool;
    callback select-review-image(int);
    callback open-image(image, string);
    callback add-review-image(int);
    callback delete-review-image(int);
    callback save-trade-premarket(int, string) -> bool;
    callback select-premarket-image(int);
    callback add-premarket-image(int);
    callback delete-premarket-image(int);
    callback abandon-trade(int) -> bool;
    function clear-journal-form()
    {
        root.journal-reset-token += 1;
    }
    callback filter-trade-costs(string, string) -> bool;
    callback save-trade(int, string, string, string, string, string, string, string, string, string, string, string, string, string, string, string, string, string, string) -> bool;
    pure callback calculate-risk-initial(string, string, string, string, string, string, string, string, string, string) -> string;
    pure callback calculate-stoploss-initial(string, string, string, string, string, string, string, string, string, string, string) -> string;
    pure callback calculate-min-target(string, string, string, string, string, string, string, string, string) -> string;
    pure callback calculate-shares-recommended(string, string, string, string, string, string, string, string) -> string;
    pure callback calculate-target(string, string, string, string, string, string, string, string, string, string) -> string;
    pure callback calculate-risk-percentage-initial(string, string, string, string, string, string, string, string, string, string, string) -> string;
    callback save-product(string, string, string, string, string, string);
    callback save-market(string, string, string);
    callback save-parameter(int, string, string, string, string, string) -> bool;
    callback quit();

    function open-context-review()
    {
        let row = root.context-trade-row;
        if row < 0 || row >= root.trades.length { return; }
        root.selected-review-row = row;
        root.selected-review-trade-id = root.trades[row].id;
        root.review-text = root.trades[row].review;
        root.select-review-image(root.selected-review-trade-id);
        root.page = "Review";
    }

    function open-context-premarket()
    {
        let row = root.context-trade-row;
        if row < 0 || row >= root.trades.length { return; }
        root.selected-premarket-row = row;
        root.selected-premarket-trade-id = root.trades[row].id;
        root.premarket-text = root.trades[row].premarket;
        root.select-premarket-image(root.selected-premarket-trade-id);
        root.page = "Pre-market analysis";
    }

    trade-context-menu := PopupWindow
    {
        x: root.context-menu-position.x;
        y: root.context-menu-position.y;
        width: 190px;
        height: root.context-trade-row >= 0 && root.context-trade-row < root.trades.length
            && !root.trades[root.context-trade-row].is-closed && !root.trades[root.context-trade-row].is-deleted
            ? 108px : 76px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle
        {
            width: 100%;
            height: 100%;
            background: root.surface;
            border-color: root.divider;
            border-width: 1px;
            border-radius: 4px;
            TradeContextItem
            {
                x: 4px; y: 4px; width: parent.width - 8px;
                label: "Review trade"; hover-color: root.faded; foreground: root.primary;
                activated => { trade-context-menu.close(); root.open-context-review(); }
            }
            TradeContextItem
            {
                x: 4px; y: 36px; width: parent.width - 8px;
                label: "Pre-market analysis"; hover-color: root.faded; foreground: root.primary;
                activated => { trade-context-menu.close(); root.open-context-premarket(); }
            }
            if root.context-trade-row >= 0 && root.context-trade-row < root.trades.length
                && !root.trades[root.context-trade-row].is-closed && !root.trades[root.context-trade-row].is-deleted:
                TradeContextItem
                {
                    x: 4px; y: 68px; width: parent.width - 8px;
                    label: "Abandon"; hover-color: root.faded; foreground: root.primary;
                    activated =>
                    {
                        trade-context-menu.close();
                        let trade-id = root.trades[root.context-trade-row].id;
                        let was-editing = root.editing-trade-id == trade-id;
                        if root.abandon-trade(trade-id) && was-editing
                        {
                            root.clear-journal-form();
                        }
                    }
                }
        }
    }

/*******************************************************************************
 * Menu
 *******************************************************************************/
    MenuBar
    {
        Menu
        {
            title: "File";
            MenuItem { title: "About"; activated => { root.page = "About"; } }
            MenuItem { title: "Quit"; activated => { root.quit(); } }
        }
        Menu
        {
            title: "Trade";
            MenuItem { title: "Journal"; activated => { root.page = "Journal"; } }
            MenuItem { title: "Review"; activated => { root.page = "Review"; } }
            MenuItem { title: "Pre-market analysis"; activated => { root.page = "Pre-market analysis"; } }
        }
        Menu
        {
            title: "Report";
            MenuItem { title: "Expectancy"; activated => { root.page = "Expectancy"; } }
            MenuItem { title: "Trade costs"; activated => { root.page = "Trade costs"; } }
        }
        Menu
        {
            title: "Admin";
            MenuItem { title: "Products"; activated => { root.page = "Products"; } }
            MenuItem { title: "Markets"; activated => { root.page = "Markets"; } }
            MenuItem { title: "Parameter"; activated => { root.page = "Parameter"; } }
        }
    }

/*******************************************************************************
 * Main content
 *******************************************************************************/
    VerticalBox
    {
        padding: 3px;
        spacing: 0px;
        HorizontalBox
        {
            spacing: 2px;
            cross-axis-alignment: center;
            Text { text: root.page; color: root.accent; font-size: 28px; font-weight: 700; }
            Rectangle { horizontal-stretch: 1; }
            if root.page != "Trade costs" && root.page != "Journal" && root.page != "Review" && root.page != "Pre-market analysis": Text { text: root.source-label; color: root.faded; vertical-alignment: center; }
            if root.page == "Journal": Text { width: 170px; font-size: 24px; vertical-alignment: center; color: root.aqua; text: root.current-pool + " " + root.base-currency; }
            if root.page == "Journal" || root.page == "Review" || root.page == "Pre-market analysis": Text { text: "Entry date"; color: root.secondary; vertical-alignment: center; }
            if root.page == "Journal" || root.page == "Review" || root.page == "Pre-market analysis": DateField { value <=> root.journal-draft-from; }
            if root.page == "Journal" || root.page == "Review" || root.page == "Pre-market analysis": Text { text: "to"; color: root.secondary; vertical-alignment: center; }
            if root.page == "Journal" || root.page == "Review" || root.page == "Pre-market analysis": DateField { value <=> root.journal-draft-to; }
            if root.page == "Journal" || root.page == "Review" || root.page == "Pre-market analysis": Button { height: 24px; text: "Apply"; clicked => { root.filter-journal(root.journal-draft-from, root.journal-draft-to); } }
            if root.page == "Journal" || root.page == "Review" || root.page == "Pre-market analysis": Button
            {
                height: 24px;
                text: "Clear"; clicked =>
                {
                    root.journal-draft-from = "";
                    root.journal-draft-to = "";
                    root.filter-journal("", "");
                }
            }
            if root.page == "Trade costs": Text { text: "Entry date"; color: root.secondary; vertical-alignment: center; }
            if root.page == "Trade costs": DateField { value <=> root.costs-draft-from; }
            if root.page == "Trade costs": Text { text: "to"; color: root.secondary; vertical-alignment: center; }
            if root.page == "Trade costs": DateField { value <=> root.costs-draft-to; }
            if root.page == "Trade costs": Button { height: 24px; text: "Apply"; clicked => { root.filter-trade-costs(root.costs-draft-from, root.costs-draft-to); } }
            if root.page == "Trade costs": Button
            {
                height: 24px;
                text: "Clear"; clicked =>
                {
                    root.costs-draft-from = "";
                    root.costs-draft-to = "";
                    root.filter-trade-costs("", "");
                }
            }
        }

        if root.page == "Trade costs":
            VerticalBox
            {
                spacing: 2px;
                Text { text: "Costs in EUR for trades opened in the selected entry date range (inclusive)."; color: root.secondary; }
                HorizontalBox
                {
                    spacing: 2px;
                    Rectangle
                    {
                        background: root.surface; border-radius: 5px; height: 64px; horizontal-stretch: 1;
                        VerticalBox
                        {
                            padding: 4px; spacing: 2px;
                            Text { text: "TRADES"; color: root.muted; font-size: 11px; }
                            Text { text: root.costs-count; color: root.primary; font-size: 18px; font-weight: 700; }
                        }
                    }
                    Rectangle
                    {
                        background: root.surface; border-radius: 5px; height: 64px; horizontal-stretch: 1;
                        VerticalBox
                        {
                            padding: 4px; spacing: 2px;
                            Text { text: "BUY COMMISSION"; color: root.muted; font-size: 11px; }
                            Text { text: root.costs-commission-buy; color: root.primary; font-size: 18px; font-weight: 700; }
                        }
                    }
                    Rectangle
                    {
                        background: root.surface; border-radius: 5px; height: 64px; horizontal-stretch: 1;
                        VerticalBox
                        {
                            padding: 4px; spacing: 2px;
                            Text { text: "BUY TAX"; color: root.muted; font-size: 11px; }
                            Text { text: root.costs-tax-buy; color: root.primary; font-size: 18px; font-weight: 700; }
                        }
                    }
                    Rectangle
                    {
                        background: root.surface; border-radius: 5px; height: 64px; horizontal-stretch: 1;
                        VerticalBox
                        {
                            padding: 4px; spacing: 2px;
                            Text { text: "SELL COMMISSION"; color: root.muted; font-size: 11px; }
                            Text { text: root.costs-commission-sell; color: root.primary; font-size: 18px; font-weight: 700; }
                        }
                    }
                    Rectangle
                    {
                        background: root.surface; border-radius: 5px; height: 64px; horizontal-stretch: 1;
                        VerticalBox
                        {
                            padding: 4px; spacing: 2px;
                            Text { text: "SELL TAX"; color: root.muted; font-size: 11px; }
                            Text { text: root.costs-tax-sell; color: root.primary; font-size: 18px; font-weight: 700; }
                        }
                    }
                    Rectangle
                    {
                        background: root.surface; border-radius: 5px; height: 64px; horizontal-stretch: 1;
                        VerticalBox
                        {
                            padding: 4px; spacing: 2px;
                            Text { text: "OTHER"; color: root.muted; font-size: 11px; }
                            Text { text: root.costs-other; color: root.primary; font-size: 18px; font-weight: 700; }
                        }
                    }
                    Rectangle
                    {
                        background: root.surface; border-radius: 5px; height: 64px; horizontal-stretch: 1;
                        VerticalBox
                        {
                            padding: 4px; spacing: 2px;
                            Text { text: "TOTAL COSTS"; color: root.muted; font-size: 11px; }
                            Text { text: root.costs-total; color: root.accent; font-size: 18px; font-weight: 700; }
                        }
                    }
                }
                Text { text: "Trading costs"; color: root.primary; font-size: 17px; font-weight: 600; }
                Rectangle { height: 1px; background: root.divider; }
                StandardTableView
                {
                    vertical-stretch: 1;
                    columns: [
                        { title: "ID", width: 55px },
                        { title: "PRODUCT", width: 145px },
                        { title: "DATE (b)", width: 110px },
                        { title: "DATE (s)", width: 110px },
                        { title: "COMM (b)", width: 100px },
                        { title: "TAX (b)", width: 90px },
                        { title: "COMM (s)", width: 100px },
                        { title: "TAX (s)", width: 90px },
                        { title: "OTHER", width: 90px },
                        { title: "TOTAL", width: 100px },
                    ];
                    rows: root.trade-cost-table-rows;
                }
            }

        if root.page == "Review": VerticalBox
        {
            spacing: 8px;
            Text
            {
                text: root.selected-review-trade-id == 0
                    ? "Select a trade in the table to write its review."
                    : "Review for trade #" + root.selected-review-trade-id;
                color: root.secondary;
                font-size: 17px;
            }
            TextEdit
            {
                height: 110px;
                enabled: root.selected-review-trade-id != 0;
                text <=> root.review-text;
            }
            Text { text: "Image (maximum 2 MB)"; color: root.secondary; }
            Rectangle
            {
                height: 125px;
                background: root.surface;
                border-radius: 5px;
                if root.review-has-image: Image
                {
                    width: 100%;
                    height: 100%;
                    source: root.review-image;
                    image-fit: contain;
                }
                if root.review-has-image: TouchArea
                {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.open-image(root.review-image, "Review image for trade #" + root.selected-review-trade-id); }
                }
                if !root.review-has-image: Text
                {
                    width: 100%;
                    height: 100%;
                    text: root.selected-review-trade-id == 0 ? "Select a trade to view its image" : "No image added";
                    color: root.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            HorizontalBox
            {
                Rectangle { horizontal-stretch: 1; }
                Button
                {
                    height: 24px;
                    text: "Add image";
                    enabled: root.selected-review-trade-id != 0 && !root.review-has-image;
                    clicked => { root.add-review-image(root.selected-review-trade-id); }
                }
                Button
                {
                    height: 24px;
                    text: "Delete image";
                    enabled: root.selected-review-trade-id != 0 && root.review-has-image;
                    clicked => { root.delete-review-image(root.selected-review-trade-id); }
                }
                Button
                {
                    height: 24px;
                    text: "Save review";
                    primary: true;
                    enabled: root.selected-review-trade-id != 0;
                    clicked => { root.save-trade-review(root.selected-review-trade-id, root.review-text); }
                }
            }
            Text { text: "Trade journal results"; color: root.primary; font-size: 17px; font-weight: 600; }
            Rectangle { height: 1px; background: root.divider; }
            Rectangle
            {
                vertical-stretch: 1;
                min-height: 200px;
                review-table := StandardTableView
                {
                width: 100%; height: 100%;
                columns: [
                    { title: "ID", width: 55px },
                    { title: "REVIEW", width: 360px },
                    { title: "PRODUCT", width: 120px },
                    { title: "SIDE", width: 75px },
                    { title: "BUY → SELL", width: 205px },
                    { title: "CURR", width: 80px },
                    { title: "QTY (b)", width: 90px },
                    { title: "QTY (s)", width: 90px },
                    { title: "PRICE (b)", width: 100px },
                    { title: "PRICE (s)", width: 100px },
                    { title: "TAX (b)", width: 90px },
                    { title: "TAX (s)", width: 90px },
                    { title: "COMM (b)", width: 100px },
                    { title: "COMM (s)", width: 100px },
                    { title: "EX (b)", width: 90px },
                    { title: "EX (s)", width: 90px },
                    { title: "STOPLOSS (init)", width: 140px },
                    { title: "TARGET (min)", width: 130px },
                    { title: "TARGET (pref)", width: 140px },
                    { title: "RISK (init)", width: 115px },
                    { title: "RISK (actual)", width: 125px },
                    { title: "P/L", width: 105px },
                    { title: "P/L (tot)", width: 105px },
                    { title: "R", width: 85px },
                ];
                rows: root.review-table-rows;
                current-row: root.selected-review-row;
                row-pointer-event(row, event, position) =>
                {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down
                    {
                        root.context-trade-row = row;
                        root.context-menu-position = {
                            x: review-table.absolute-position.x + position.x,
                            y: review-table.absolute-position.y + position.y,
                        };
                        trade-context-menu.show();
                    }
                }
                current-row-changed(row) =>
                {
                    if row < 0 || row >= root.trades.length
                    {
                        root.selected-review-row = -1;
                        root.selected-review-trade-id = 0;
                        root.review-text = "";
                        root.select-review-image(0);
                        return;
                    }
                    root.selected-review-row = row;
                    root.selected-review-trade-id = root.trades[row].id;
                    root.review-text = root.trades[row].review;
                    root.select-review-image(root.selected-review-trade-id);
                }
                }
                FadedTradeRows
                {
                    trades: root.trades;
                    body-top: 42px;
                    body-height: review-table.height - 42px;
                    content-y: review-table.content-y;
                    content-height: review-table.content-height;
                }
            }
        }

        if root.page == "Pre-market analysis": VerticalBox
        {
            spacing: 8px;
            Text
            {
                text: root.selected-premarket-trade-id == 0
                    ? "Select a trade in the table to write its pre-market analysis."
                    : "Pre-market analysis for trade #" + root.selected-premarket-trade-id;
                color: root.secondary;
                font-size: 17px;
            }
            TextEdit
            {
                height: 110px;
                enabled: root.selected-premarket-trade-id != 0;
                text <=> root.premarket-text;
            }
            Text { text: "Image (maximum 2 MB)"; color: root.secondary; }
            Rectangle
            {
                height: 125px;
                background: root.surface;
                border-radius: 5px;
                if root.premarket-has-image: Image
                {
                    width: 100%;
                    height: 100%;
                    source: root.premarket-image;
                    image-fit: contain;
                }
                if root.premarket-has-image: TouchArea
                {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.open-image(root.premarket-image, "Pre-market image for trade #" + root.selected-premarket-trade-id); }
                }
                if !root.premarket-has-image: Text
                {
                    width: 100%;
                    height: 100%;
                    text: root.selected-premarket-trade-id == 0 ? "Select a trade to view its image" : "No image added";
                    color: root.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            HorizontalBox
            {
                Rectangle { horizontal-stretch: 1; }
                Button
                {
                    height: 24px;
                    text: "Add image";
                    enabled: root.selected-premarket-trade-id != 0 && !root.premarket-has-image;
                    clicked => { root.add-premarket-image(root.selected-premarket-trade-id); }
                }
                Button
                {
                    height: 24px;
                    text: "Delete image";
                    enabled: root.selected-premarket-trade-id != 0 && root.premarket-has-image;
                    clicked => { root.delete-premarket-image(root.selected-premarket-trade-id); }
                }
                Button
                {
                    height: 24px;
                    text: "Save analysis";
                    primary: true;
                    enabled: root.selected-premarket-trade-id != 0;
                    clicked => { root.save-trade-premarket(root.selected-premarket-trade-id, root.premarket-text); }
                }
            }
            Text { text: "Trade journal results"; color: root.primary; font-size: 17px; font-weight: 600; }
            Rectangle { height: 1px; background: root.divider; }
            Rectangle
            {
                vertical-stretch: 1;
                min-height: 200px;
                premarket-table := StandardTableView
                {
                width: 100%; height: 100%;
                columns: [
                    { title: "ID", width: 55px },
                    { title: "PRE-MARKET", width: 360px },
                    { title: "PRODUCT", width: 120px },
                    { title: "SIDE", width: 75px },
                    { title: "BUY → SELL", width: 205px },
                    { title: "CURR", width: 80px },
                    { title: "QTY (b)", width: 90px },
                    { title: "QTY (s)", width: 90px },
                    { title: "PRICE (b)", width: 100px },
                    { title: "PRICE (s)", width: 100px },
                    { title: "TAX (b)", width: 90px },
                    { title: "TAX (s)", width: 90px },
                    { title: "COMM (b)", width: 100px },
                    { title: "COMM (s)", width: 100px },
                    { title: "EX (b)", width: 90px },
                    { title: "EX (s)", width: 90px },
                    { title: "STOPLOSS (init)", width: 140px },
                    { title: "TARGET (min)", width: 130px },
                    { title: "TARGET (pref)", width: 140px },
                    { title: "RISK (init)", width: 115px },
                    { title: "RISK (actual)", width: 125px },
                    { title: "P/L", width: 105px },
                    { title: "P/L (tot)", width: 105px },
                    { title: "R", width: 85px },
                ];
                rows: root.premarket-table-rows;
                current-row: root.selected-premarket-row;
                row-pointer-event(row, event, position) =>
                {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down
                    {
                        root.context-trade-row = row;
                        root.context-menu-position = {
                            x: premarket-table.absolute-position.x + position.x,
                            y: premarket-table.absolute-position.y + position.y,
                        };
                        trade-context-menu.show();
                    }
                }
                current-row-changed(row) =>
                {
                    if row < 0 || row >= root.trades.length
                    {
                        root.selected-premarket-row = -1;
                        root.selected-premarket-trade-id = 0;
                        root.premarket-text = "";
                        root.select-premarket-image(0);
                        return;
                    }
                    root.selected-premarket-row = row;
                    root.selected-premarket-trade-id = root.trades[row].id;
                    root.premarket-text = root.trades[row].premarket;
                    root.select-premarket-image(root.selected-premarket-trade-id);
                }
                }
                FadedTradeRows
                {
                    trades: root.trades;
                    body-top: 42px;
                    body-height: premarket-table.height - 42px;
                    content-y: premarket-table.content-y;
                    content-height: premarket-table.content-height;
                }
            }
        }

/*******************************************************************************
 * Info boxes expectancy.
 *******************************************************************************/
        if root.page == "Journal" || root.page == "Expectancy": VerticalBox
        {
            spacing: 2px;
            HorizontalBox
            {
                Rectangle
                {
                    background: root.surface; border-radius: 5px; height: 64px; horizontal-stretch: 1;
                    VerticalBox
                    {
                        padding: 8px; spacing: 2px;
                        Text { text: "TRADES"; color: root.muted; font-size: 11px; }
                        Text { text: root.trade-count; color: root.primary; font-size: 18px; font-weight: 700; }
                    }
                }
                Rectangle
                {
                    background: root.surface; border-radius: 5px; height: 64px; horizontal-stretch: 1;
                    VerticalBox
                    {
                        padding: 8px; spacing: 2px;
                        Text { text: "WIN RATE"; color: root.muted; font-size: 11px; }
                        Text { text: root.win-rate; color: root.primary; font-size: 18px; font-weight: 700; }
                    }
                }
                Rectangle
                {
                    background: root.surface; border-radius: 5px; height: 64px; horizontal-stretch: 1;
                    VerticalBox
                    {
                        padding: 8px; spacing: 2px;
                        Text { text: "EXPECTANCY"; color: root.muted; font-size: 11px; }
                        Text { text: root.expectancy; color: root.accent; font-size: 18px; font-weight: 700; }
                    }
                }
                Rectangle
                {
                    background: root.surface; border-radius: 5px; height: 64px; horizontal-stretch: 1;
                    VerticalBox
                    {
                        padding: 8px; spacing: 2px;
                        Text { text: "TOTAL P/L"; color: root.muted; font-size: 11px; }
                        Text { text: root.total-pl; color: root.primary; font-size: 18px; font-weight: 700; }
                    }
                }
            }

/*******************************************************************************
 * Descriptive info expectancy page.
 *******************************************************************************/
            if root.page == "Expectancy": VerticalBox
            {
                spacing: 4px;
                Text { text: "Expectancy = average of (trade P/L ÷ initial risk)"; color: root.primary; font-size: 17px; }
                Text { text: "Only is-closed trades with a positive initial risk are included. The Journal entry date range updates all figures above."; color: root.secondary; }
                Text { text: "P/L is the gross price move; initial risk comes from the stoploss or risk percentage. Costs are stored separately."; color: root.secondary; }
                Rectangle { vertical-stretch: 1; }
            }

/*******************************************************************************
 * Trade journal input
 *******************************************************************************/
            if root.page == "Journal": journal := VerticalBox
            {
                spacing: 0px;
                padding: 0px;
                private property <int> reset-token: root.journal-reset-token;
                changed reset-token => { journal.reset-inputs(); }
                private property <string> validation-warning:
                    date-buy.value == "" && date-sell.value == ""
                        ? "Enter at least one trade date."
                        : shares-buy.text == "" && shares-sell.text == ""
                            ? "Enter at least one shares value."
                            : commission-buy.text == "" && commission-sell.text == ""
                                ? "Enter at least one commission value."
                                : tax-buy.text == "" && tax-sell.text == ""
                                    ? "Enter at least one tax value."
                                    : trade-side.current-value == "Long" && (date-buy.value == "" || shares-buy.text == "" || commission-buy.text == "" || tax-buy.text == "")
                                        ? "Long trades need buy date, shares, commission, and tax."
                                        : trade-side.current-value == "Short" && (date-sell.value == "" || shares-sell.text == "" || commission-sell.text == "" || tax-sell.text == "")
                                            ? "Short trades need sell date, shares, commission, and tax."
                                            : date-buy.value != "" && date-sell.value != "" && (shares-buy.text == "" || shares-sell.text == "" || commission-buy.text == "" || commission-sell.text == "" || tax-buy.text == "" || tax-sell.text == "")
                                                ? "Closed trades need buy and sell shares, commissions, and taxes."
                                                : "";
                changed validation-warning => { root.trade-warning = journal.validation-warning; }
                function refresh-risk-inputs()
                {
                    if (root.risk-entry-mode == "percent")
                    {
                        stoploss.text = risk-percent.text == ""
                            ? ""
                            : root.calculate-stoploss-initial(
                                root.trade-pool, risk-percent.text, price-buy.text, price-sell.text, shares-buy.text, shares-sell.text,
                                commission-buy.text, commission-sell.text, tax-buy.text, tax-sell.text, trade-side.current-value);
                    }
                    else if (root.risk-entry-mode == "stoploss")
                    {
                        risk-percent.text = stoploss.text == ""
                            ? ""
                            : root.calculate-risk-percentage-initial(
                                price-buy.text, shares-buy.text, tax-buy.text, commission-buy.text,
                                price-sell.text, shares-sell.text, tax-sell.text, commission-sell.text,
                                stoploss.text, root.trade-pool, trade-side.current-value);
                    }
                }
                function reset-inputs()
                {
                    root.editing-trade-id = 0;
                    root.selected-trade-row = -1;
                    trade-side.current-value = "Long";
                    date-buy.value = "";
                    date-sell.value = "";
                    shares-buy.text = "1";
                    shares-sell.text = "";
                    price-buy.text = "0";
                    price-sell.text = "0";
                    exchange-rate-buy.text = "1";
                    exchange-rate-sell.text = "1";
                    commission-buy.text = "0";
                    tax-buy.text = "0";
                    commission-sell.text = "";
                    tax-sell.text = "";
                    cost-other.text = "0";
                    risk-percent.text = "";
                    stoploss.text = "";
                    root.risk-entry-mode = "";
                    root.trade-pool = root.current-pool-exact;
                }
                HorizontalBox
                {
                    Text { text: root.editing-trade-id == 0 ? "Log trade" : "Edit trade #" + root.editing-trade-id; color: root.accent; font-size: 16px; font-weight: 600; }
                    Rectangle { horizontal-stretch: 1; }
                    if root.editing-trade-id != 0:
                        Button
                        {
                            text: "New trade";
                            height: 24px;
                            primary: true;
                            clicked => { journal.reset-inputs(); }
                       }
                }
                HorizontalBox
                {
                    VerticalBox
                    {
                        Text { text: "Product"; color: root.secondary;}
                        trade-product := ComboBox { width: 180px; model: root.products; height: 24px; }
                    }
                    VerticalBox
                    {
                        Text { text: "Side"; color: root.secondary; }
                        trade-side := ComboBox
                        {
                            width: 90px;
                            model: ["Long", "Short"];
                            current-value: "Long";
                            height: 24px;
                            selected(value) =>
                            {
                                if root.editing-trade-id == 0
                                {
                                    date-buy.value = "";
                                    date-sell.value = "";
                                    shares-buy.text = value == "Long" ? "1" : "";
                                    shares-sell.text = value == "Short" ? "1" : "";
                                    commission-buy.text = value == "Long" ? "0" : "";
                                    tax-buy.text = value == "Long" ? "0" : "";
                                    commission-sell.text = value == "Short" ? "0" : "";
                                    tax-sell.text = value == "Short" ? "0" : "";
                                    price-buy.text = "0";
                                    price-sell.text = "0";
                                    risk-percent.text = "";
                                    stoploss.text = "";
                                    root.risk-entry-mode = "";
                                }
                            }
                        }
                    }
                    VerticalBox
                    {
                        Text { text: "Date buy"; color: root.secondary; }
                        date-buy := DateField { padding: 0px; }
                    }
                    VerticalBox
                    {
                        Text { text: "Date sell"; color: root.secondary; }
                        date-sell := DateField { padding: 0px; }
                    }
                    VerticalBox
                    {
                        Text { text: "Shares buy"; color: root.secondary; }
                        shares-buy := LineEdit { text: "1"; height: 24px; edited(_) => { if (trade-side.current-value == "Long") { journal.refresh-risk-inputs(); } } }
                    }
                    VerticalBox
                    {
                        Text { text: "Shares sell"; color: root.secondary; }
                        shares-sell := LineEdit { text: ""; height: 24px; edited(_) => { if (trade-side.current-value == "Short") { journal.refresh-risk-inputs(); } } }
                    }
                }
                HorizontalBox
                {
                    VerticalBox
                    {
                        Text { text: "Price buy"; color: root.secondary; }
                        price-buy := LineEdit { text: "0"; height: 24px; edited(_) => { if (trade-side.current-value == "Long") { journal.refresh-risk-inputs(); } } }
                    }
                    VerticalBox
                    {
                        Text { text: "Sell price"; color: root.secondary; }
                        price-sell := LineEdit { text: "0"; height: 24px; edited(_) => { if (trade-side.current-value == "Short") { journal.refresh-risk-inputs(); } } }
                    }
                    VerticalBox
                    {
                        Text { text: "Exchange rate buy (to " + root.base-currency + ")"; color: root.secondary; }
                        exchange-rate-buy := LineEdit { text: "1"; height: 24px; }
                    }
                    VerticalBox
                    {
                        Text { text: "Exchange rate sell (to " + root.base-currency + ")"; color: root.secondary; }
                        exchange-rate-sell := LineEdit { text: "1"; height: 24px; }
                    }
                }
                HorizontalBox
                {
                    VerticalBox
                    {
                        Text { text: "Commission buy"; color: root.secondary; }
                        commission-buy := LineEdit { text: "0"; height: 24px; edited(_) => { if (trade-side.current-value == "Long") { journal.refresh-risk-inputs(); } } }
                    }
                    VerticalBox
                    {
                        Text { text: "Tax buy"; color: root.secondary; }
                        tax-buy := LineEdit { text: "0"; height: 24px; edited(_) => { if (trade-side.current-value == "Long") { journal.refresh-risk-inputs(); } } }
                    }
                    VerticalBox
                    {
                        Text { text: "Commission sell"; color: root.secondary; }
                        commission-sell := LineEdit { text: ""; height: 24px; edited(_) => { if (trade-side.current-value == "Short") { journal.refresh-risk-inputs(); } } }
                    }
                    VerticalBox
                    {
                        Text { text: "Tax sell"; color: root.secondary; }
                        tax-sell := LineEdit { text: ""; height: 24px; edited(_) => { if (trade-side.current-value == "Short") { journal.refresh-risk-inputs(); } } }
                    }
                    VerticalBox
                    {
                        Text { text: "Other costs"; color: root.secondary; }
                        cost-other := LineEdit { text: "0"; height: 24px; }
                    }
                    VerticalBox
                    {
                        Text { text: "Risk %"; color: root.secondary; }
                        risk-percent := LineEdit
                        {
                            placeholder-text: "Percent of pool";
                             height: 24px;
                            edited(text) =>
                            {
                                root.risk-entry-mode = "percent";
                                journal.refresh-risk-inputs();
                            }
                        }
                    }
                    VerticalBox
                    {
                        Text { text: "Stoploss"; color: root.secondary; }
                        stoploss := LineEdit
                        {
                            placeholder-text: "Price per unit";
                            height: 24px;
                            edited(text) =>
                            {
                                root.risk-entry-mode = "stoploss";
                                journal.refresh-risk-inputs();
                            }
                        }
                    }
                }
                HorizontalBox
                {
                    Rectangle { horizontal-stretch: 1; }
                    Button
                    {
                        text: root.editing-trade-id == 0 ? "Log trade" : "Save changes";
                        height: 24px;
                        primary: true;
                        clicked =>
                        {
                            if root.save-trade(root.editing-trade-id, trade-product.current-value, trade-side.current-value,
                                date-buy.value, date-sell.value, shares-buy.text, shares-sell.text, price-buy.text,
                                price-sell.text, exchange-rate-buy.text, exchange-rate-sell.text, commission-buy.text, tax-buy.text, commission-sell.text, tax-sell.text, cost-other.text,
                                risk-percent.text, stoploss.text, root.trade-pool)
                            {
                                root.editing-trade-id = 0;
                                root.selected-trade-row = -1;
                                trade-side.current-value = "Long";
                                date-buy.value = "";
                                date-sell.value = "";
                                shares-buy.text = "1";
                                shares-sell.text = "";
                                price-buy.text = "0";
                                price-sell.text = "0";
                                exchange-rate-buy.text = "1";
                                exchange-rate-sell.text = "1";
                                commission-buy.text = "0";
                                tax-buy.text = "0";
                                commission-sell.text = "";
                                tax-sell.text = "";
                                cost-other.text = "0";
                                risk-percent.text = "";
                                stoploss.text = "";
                                root.risk-entry-mode = "";
                                root.trade-pool = root.current-pool-exact;
                            }
                        }
                    }
                }

/*******************************************************************************
 * Trade journal info and results
 *******************************************************************************/
                HorizontalBox
                {
                    Text { text: "Info"; color: root.secondary; font-size: 17px; font-weight: 600; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "Recommended shares"; color: root.secondary; }
                    Text
                    {
                        text: root.calculate-shares-recommended(
                            root.trade-pool, commission-buy.text, tax-buy.text, price-buy.text,
                            commission-sell.text, tax-sell.text, price-sell.text, trade-side.current-value);
                        color: root.aqua;
                    }
                    Text
                    {
                         text: "Risk";
                         color: root.secondary;
                    }
                    Text
                    {
                        text: stoploss.text == ""
                            ? "0.0"
                            : root.calculate-risk-initial(
                                stoploss.text, price-buy.text, price-sell.text, shares-buy.text, shares-sell.text,
                                commission-buy.text, commission-sell.text, tax-buy.text, tax-sell.text, trade-side.current-value).to-float().to-fixed(2);
                        color: root.aqua;
                    }
                    Text { text: "Risk %"; color: root.secondary; }
                    Text
                    {
                        text: risk-percent.text == ""
                            ? "0.0"
                            : risk-percent.text.to-float().to-fixed(2);
                        color: root.aqua;
                    }
                    Text { text: "Stoploss"; color: root.secondary; }
                    Text
                    {
                        text: stoploss.text == ""
                            ? "0.0"
                            : stoploss.text.to-float().to-fixed(2);
                        color: root.aqua;
                    }
                    Text { text: "Min. target"; color: root.secondary; }
                    Text
                    {
                        text: root.calculate-min-target(
                            price-buy.text, shares-buy.text, tax-buy.text, commission-buy.text,
                            price-sell.text, shares-sell.text, tax-sell.text, commission-sell.text,
                            trade-side.current-value);
                        color: root.aqua;
                    }
                    Text { text: "Target"; color: root.secondary; }
                    Text
                    {
                        text: root.calculate-target(
                            price-buy.text, shares-buy.text, tax-buy.text, commission-buy.text,
                            price-sell.text, shares-sell.text, tax-sell.text, commission-sell.text,
                            stoploss.text, trade-side.current-value);
                        color: root.aqua;
                    }
                }
                Rectangle { height: 1px; background: root.divider; }
/*******************************************************************************
 * Trade journal results
 *******************************************************************************/
                Rectangle
                {
                    vertical-stretch: 1;
                    min-height: 200px;
                    journal-table := StandardTableView
                    {
                        width: 100%;
                        height: 100%;
                    columns: [
                        { title: "ID", width: 55px },
                        { title: "PRODUCT", width: 120px },
                        { title: "SIDE", width: 75px },
                        { title: "BUY → SELL", width: 205px },
                        { title: "CURR", width: 80px },
                        { title: "QTY (b)", width: 90px },
                        { title: "QTY (s)", width: 90px },
                        { title: "PRICE (b)", width: 100px },
                        { title: "PRICE (s)", width: 100px },
                        { title: "TAX (b)", width: 90px },
                        { title: "TAX (s)", width: 90px },
                        { title: "COMM (b)", width: 100px },
                        { title: "COMM (s)", width: 100px },
                        { title: "EX (b)", width: 90px },
                        { title: "EX (s)", width: 90px },
                        { title: "STOPLOSS (init)", width: 140px },
                        { title: "TARGET (min)", width: 130px },
                        { title: "TARGET (pref)", width: 140px },
                        { title: "RISK (init)", width: 115px },
                        { title: "RISK (actual)", width: 125px },
                        { title: "P/L", width: 105px },
                        { title: "P/L (tot)", width: 105px },
                        { title: "R", width: 85px },
                    ];
                    rows: root.trade-table-rows;
                    current-row: root.selected-trade-row;
                    row-pointer-event(row, event, position) =>
                    {
                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down
                        {
                            root.context-trade-row = row;
                            root.context-menu-position = {
                                x: journal-table.absolute-position.x + position.x,
                                y: journal-table.absolute-position.y + position.y,
                            };
                            trade-context-menu.show();
                        }
                    }
                    current-row-changed(row) =>
                    {
                        if row < 0 || row >= root.trades.length || root.trades[row].is-closed || root.trades[row].is-deleted
                        {
                            journal-table.current-row = root.selected-trade-row;
                            return;
                        }
                        root.selected-trade-row = row;
                        root.editing-trade-id = root.trades[row].id;
                        trade-product.current-value = root.trades[row].product;
                        trade-side.current-value = root.trades[row].side;
                        date-buy.value = root.trades[row].date-buy;
                        date-sell.value = root.trades[row].date-sell;
                        shares-buy.text = root.trades[row].edit-shares-buy;
                        shares-sell.text = root.trades[row].edit-shares-sell;
                        price-buy.text = root.trades[row].price-buy;
                        price-sell.text = root.trades[row].price-sell;
                        exchange-rate-buy.text = root.trades[row].exchange-rate-buy;
                        exchange-rate-sell.text = root.trades[row].exchange-rate-sell;
                        commission-buy.text = root.trades[row].commission-buy;
                        tax-buy.text = root.trades[row].tax-buy;
                        commission-sell.text = root.trades[row].commission-sell;
                        tax-sell.text = root.trades[row].tax-sell;
                        cost-other.text = root.trades[row].cost-other;
                        risk-percent.text = root.trades[row].risk-percent-initial;
                        stoploss.text = root.trades[row].stoploss-initial;
                        root.risk-entry-mode = root.trades[row].stoploss-initial == "" ? "percent" : "stoploss";
                        root.trade-pool = root.trades[row].trade-pool == "" ? root.current-pool-exact : root.trades[row].trade-pool;
                    }
                    }
                    FadedTradeRows
                    {
                        trades: root.trades;
                        body-top: 42px;
                        body-height: journal-table.height - 42px;
                        content-y: journal-table.content-y;
                        content-height: journal-table.content-height;
                    }
                }
            }
        }

/*******************************************************************************
 * Products
 *******************************************************************************/
        if root.page == "Products": VerticalBox
        {
            spacing: 8px;
            Text { text: "Add product"; color: root.accent; font-size: 17px; font-weight: 600; }
            HorizontalBox
            {
                spacing: 3px;
                VerticalBox
                {
                    Text { text: "Name"; color: root.secondary; }
                    product-name := LineEdit { placeholder-text: "Product code"; }
                }
                VerticalBox
                {
                    Text { text: "Description"; color: root.secondary; }
                    product-description := LineEdit { placeholder-text: "Description"; }
                }
                VerticalBox
                {
                    Text { text: "Currency"; color: root.secondary; }
                    product-currency := ComboBox { width: 90px; model: ["EUR", "USD", "GBP"]; current-value: "EUR"; }
                }
                VerticalBox
                {
                    Text { text: "Market"; color: root.secondary; }
                    product-market := ComboBox
                    {
                        width: 185px;
                        model: root.market-codes;
                        current-value: "EUREX";
                    }
                }
            }
            HorizontalBox
            {
                spacing: 8px;
                VerticalBox
                {
                    Text { text: "Tick"; color: root.secondary; }
                    product-tick := LineEdit { width: 140px; text: "1"; }
                }
                VerticalBox
                {
                    Text { text: "Tick value"; color: root.secondary; }
                    product-tick-value := LineEdit { width: 140px; text: "1"; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalBox
            {
                Rectangle { horizontal-stretch: 1; }
                Button
                {
                    text: "Add product";
                    height: 24px;
                    primary: true;
                    clicked =>
                    {
                        root.save-product(product-name.text, product-description.text, product-currency.current-value, product-market.current-value, product-tick.text, product-tick-value.text);
                    }
                }
            }
            Text { text: "Product catalog"; color: root.primary; font-size: 17px; font-weight: 600; }
            Rectangle { height: 1px; background: root.divider; }
            StandardTableView
            {
                vertical-stretch: 1;
                columns: [
                    { title: "NAME", width: 190px },
                    { title: "CURRENCY", width: 125px },
                    { title: "MARKET", width: 200px },
                    { title: "TICK", width: 90px },
                    { title: "TICK VALUE", width: 120px },
                    { title: "DESCRIPTION", width: 520px },
                ];
                rows: root.product-table-rows;
            }
        }

/*******************************************************************************
 * Markets
 *******************************************************************************/
        if root.page == "Markets": VerticalBox
        {
            spacing: 8px;
            Text { text: "Add market"; color: root.accent; font-size: 17px; font-weight: 600; }
            HorizontalBox
            {
                spacing: 3px;
                VerticalBox
                {
                    Text { text: "Code"; color: root.secondary; }
                    market-code := LineEdit { placeholder-text: "Market code"; }
                }
                VerticalBox
                {
                    Text { text: "Name"; color: root.secondary; }
                    market-name := LineEdit { placeholder-text: "Market name"; }
                }
                VerticalBox
                {
                    Text { text: "Country"; color: root.secondary; }
                    market-country := LineEdit { placeholder-text: "Country"; }
                }
            }
            HorizontalBox
            {
                Rectangle { horizontal-stretch: 1; }
                Button
                {
                    text: "Add market";
                    height: 24px;
                    primary: true;
                    clicked =>
                    {
                        root.save-market(market-code.text, market-name.text, market-country.text);
                    }
                }
            }
            Text { text: "Market catalog"; color: root.primary; font-size: 17px; font-weight: 600; }
            Rectangle { height: 1px; background: root.divider; }
            StandardTableView
            {
                vertical-stretch: 1;
                columns: [
                    { title: "CODE", width: 200px },
                    { title: "NAME", width: 390px },
                    { title: "COUNTRY", width: 250px },
                ];
                rows: root.market-table-rows;
            }
        }

/*******************************************************************************
 * Parameter
 *******************************************************************************/
        if root.page == "Parameter": VerticalBox
        {
            spacing: 8px;
            Text
            {
                text: root.editing-parameter-id == 0 ? "Add parameter" : "Edit parameter #" + root.editing-parameter-id;
                color: root.accent;
                font-size: 17px;
                font-weight: 600;
            }
            HorizontalBox
            {
                spacing: 4px;
                VerticalBox { Text { text: "Name"; color: root.secondary; } LineEdit { text <=> root.parameter-name; placeholder-text: "Parameter name"; } }
                VerticalBox { Text { text: "Value"; color: root.secondary; } LineEdit { text <=> root.parameter-value; placeholder-text: "Value"; } }
                VerticalBox { Text { text: "Default value"; color: root.secondary; } LineEdit { text <=> root.parameter-default; placeholder-text: "Default value"; } }
                VerticalBox { Text { text: "Datatype"; color: root.secondary; } LineEdit { text <=> root.parameter-datatype; placeholder-text: "e.g. string"; } }
            }
            HorizontalBox
            {
                spacing: 4px;
                VerticalBox { Text { text: "Description"; color: root.secondary; } LineEdit { text <=> root.parameter-description; placeholder-text: "Description"; } }
            }
            HorizontalBox
            {
                Rectangle { horizontal-stretch: 1; }
                Button
                {
                    enabled: root.editing-parameter-id != 0;
                    text: "Save changes";
                    height: 24px;
                    primary: true;
                    clicked =>
                    {
                        if root.save-parameter(root.editing-parameter-id, root.parameter-name, root.parameter-value, root.parameter-default, root.parameter-description, root.parameter-datatype)
                        {
                            root.editing-parameter-id = 0;
                            root.selected-parameter-row = -1;
                            root.parameter-name = "";
                            root.parameter-value = "";
                            root.parameter-default = "";
                            root.parameter-description = "";
                            root.parameter-datatype = "string";
                        }
                    }
                }
            }
            Text { text: "Parameters"; color: root.primary; font-size: 17px; font-weight: 600; }
            Rectangle { height: 1px; background: root.divider; }
            
            parameter-table := StandardTableView
            {
                vertical-stretch: 1;
                columns: [
                    { title: "ID", width: 65px },
                    { title: "NAME", width: 190px },
                    { title: "VALUE", width: 160px },
                    { title: "DEFAULT", width: 160px },
                    { title: "TYPE", width: 110px },
                    { title: "DESCRIPTION", width: 280px },
                ];
                rows: root.parameter-table-rows;
                current-row: root.selected-parameter-row;
                current-row-changed(row) =>
                {
                    if row < 0 || row >= root.parameters.length
                    {
                        return;
                    }
                    root.selected-parameter-row = row;
                    root.editing-parameter-id = root.parameters[row].id;
                    root.parameter-name = root.parameters[row].name;
                    root.parameter-value = root.parameters[row].value;
                    root.parameter-default = root.parameters[row].value-default;
                    root.parameter-description = root.parameters[row].description;
                    root.parameter-datatype = root.parameters[row].datatype;
                }
            }
        }

/*******************************************************************************
 * About
 *******************************************************************************/
        if root.page == "About": VerticalBox
        {
            spacing: 8px;
            Text { text: "CapitalCommander"; color: root.primary; font-size: 22px; font-weight: 600; }
            Text { text: "Trading journal with a local SQLite database."; color: root.secondary; }
            Rectangle { vertical-stretch: 1; }
        }

/*******************************************************************************
 * Log area
 *******************************************************************************/
        Rectangle { vertical-stretch: 1; }
        ScrollView
        {
            width: 100%;
            height: 50px;
            vertical-scrollbar-policy: always-on;
            horizontal-scrollbar-policy: always-off;
            VerticalBox
            {
                padding: 3px;
                spacing: 0px;
                Rectangle { height: 1px; background: root.log; }
                Text { text: root.status; color: root.log; font-size: 12px; }
                if root.page == "Journal" && root.trade-warning != "":
                    Text { text: root.trade-warning; color: root.log; font-size: 12px; }
            }
        }
    }
}
